{
  "name": "squa-world-studio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "SQUA World Studio — éditeur web de mondes et de scènes 3D (Phase 2 : modèles 3D et bibliothèque).",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "test": "node --experimental-strip-types --no-warnings --test \"src/core/__tests__/*.test.ts\""
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  }
}
